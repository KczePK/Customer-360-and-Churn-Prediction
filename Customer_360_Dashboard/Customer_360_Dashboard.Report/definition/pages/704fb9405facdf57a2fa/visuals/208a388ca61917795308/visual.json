              {
                "textRuns": [
                  {
                    "value": "หลักเกณฑ์ RFM – ลูกค้างานบริการ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "16pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "ข้อมูล: รายได้งานบริการ (GL 402) ที่ระบุลูกค้าได้ 1 ราย | คำนวณทุกเดือน และแสดง ณ เดือนล่าสุดของปีงบที่เลือก | ใบแจ้งหนี้ = เอกสารที่รายได้สุทธิ > 0 (ไม่นับใบลดหนี้)",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "คะแนน R / F / M (5 = ดีที่สุด, เกณฑ์คงที่ทุกเดือน)",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#118dff"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "R  เดือนนับจากใบแจ้งหนี้ล่าสุด:   5 = 0–1   |   4 = 2–3   |   3 = 4–6   |   2 = 7–12   |   1 = 13+",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "F  จำนวนใบแจ้งหนี้ใน 12 เดือน:   5 = 10+   |   4 = 5–9   |   3 = 3–4   |   2 = 2   |   1 = 0–1",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "M  รายได้สุทธิใน 12 เดือน:   5 = ฿150,000+   |   4 = ฿50,000–149,999   |   3 = ฿15,000–49,999   |   2 = ฿5,000–14,999   |   1 = ต่ำกว่า ฿5,000",
                    "textStyle": {
                      "fontSize": "11pt"
