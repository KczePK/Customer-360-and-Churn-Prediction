                    }
                  },
                  {
                    "value": "  –  ลงนามล่าสุด 25–48 เดือน, ไม่มีสัญญาดำเนินอยู่",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "R08 Lost Client",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
