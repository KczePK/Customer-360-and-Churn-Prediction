	partition 'silver dim_customer' = m
		mode: import
		source =
				let
				  // Sampled + perturbed: fake customers, ids, documents, fund codes, org; amounts x random factor
				  Data = Text.Combine({
				    "",
				    "",
				    "",
				    "",
				    ""
				  }),
				  Rows = Json.Document(Binary.Decompress(Binary.FromText(Data, BinaryEncoding.Base64), Compression.Deflate)),
				  Source = Table.FromRows(Rows, {"customer_id", "primary_customer_name", "tax_no", "customer_type", "tsic_code_f", "activity_label", "class_label", "group_label", "division_label", "section_label", "full_address", "subdistrict_th", "province_th", "district_th"}),
				  Typed = Table.TransformColumnTypes(Source, {{"customer_id", type text}, {"primary_customer_name", type text}, {"tax_no", type text}, {"customer_type", type text}, {"tsic_code_f", type text}, {"activity_label", type text}, {"class_label", type text}, {"group_label", type text}, {"division_label", type text}, {"section_label", type text}, {"full_address", type text}, {"subdistrict_th", type text}, {"province_th", type text}, {"district_th", type text}}, "en-US")
				in
				  Typed

	annotation PBI_ResultType = Table

