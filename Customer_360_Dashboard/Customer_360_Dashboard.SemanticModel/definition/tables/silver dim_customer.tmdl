	column province_th
		dataType: string
		lineageTag: 5c36786e-d46d-475e-84a1-4d3ec19c2b73
		summarizeBy: none
		sourceColumn: province_th

		annotation SummarizationSetBy = Automatic

	column 'Province (map)' =
			-- province + country so the map places Thai province names in Thailand; blank when unknown
			VAR p = TRIM ( 'silver dim_customer'[province_th] )
			RETURN IF ( LEN ( p ) = 0, BLANK (), p & ", Thailand" )
		dataType: string
		lineageTag: c786a4eb-6be3-4839-af47-2568bef1c034
		dataCategory: Place
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column district_th
		dataType: string
		lineageTag: c64505f2-f843-46ae-b086-eb7b32021fbb
		summarizeBy: none
		sourceColumn: district_th

		annotation SummarizationSetBy = Automatic

	column 'Customer Address' =
			-- full_address holds only house no. / moo / road (DBD); add sub-district, district, province in Thai address form
			-- Bangkok: แขวง / เขต / กรุงเทพมหานคร; elsewhere: ต. / อ. / จ.
			VAR a = TRIM ( 'silver dim_customer'[full_address] )
			VAR s = TRIM ( 'silver dim_customer'[subdistrict_th] )
			VAR d = TRIM ( 'silver dim_customer'[district_th] )
			VAR p = TRIM ( 'silver dim_customer'[province_th] )
			VAR bkk = CONTAINSSTRING ( p, "กรุงเทพ" )
			VAR txt =
			    a
			        & IF ( LEN ( s ) > 0, " " & IF ( bkk, "แขวง", "ต." ) & s )
			        & IF ( LEN ( d ) > 0, " " & IF ( bkk, "เขต", "อ." ) & d )
			        & IF ( LEN ( p ) > 0, " " & IF ( bkk, p, "จ." & p ) )
			RETURN IF ( LEN ( TRIM ( txt ) ) = 0, BLANK (), TRIM ( txt ) )
		dataType: string
		lineageTag: 48ec0174-668b-4007-a31e-33ad9cdf2ab2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Industry (Org)' =
			-- top level of the Org Center TSIC chart: TSIC section, but section Z (ไม่จัดประเภท) is split into its divisions
			-- Z1 government / education and Z2 individuals are real customer groups; Z3 (not found in DBD), Z9 (DBD not specified)
			-- and blank TSIC are grouped as ไม่ทราบประเภทธุรกิจ (excluded from the chart, shown as a % in its subtitle)
			VAR s = 'silver dim_customer'[section_label]
			VAR d = 'silver dim_customer'[division_label]
			RETURN
			    SWITCH (
			        TRUE (),
			        LEN ( s ) = 0, "ไม่ทราบประเภทธุรกิจ",
			        LEFT ( d, 2 ) IN { "Z3", "Z9" }, "ไม่ทราบประเภทธุรกิจ",
			        LEFT ( s, 1 ) = "Z", d,
			        s
			    )
		dataType: string
		lineageTag: 1e751345-3f5e-4516-9f56-59c647979568
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	hierarchy 'section_label Hierarchy'
