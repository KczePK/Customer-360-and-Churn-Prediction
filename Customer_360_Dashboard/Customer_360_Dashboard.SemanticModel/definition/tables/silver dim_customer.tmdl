	column 'TSIC (dim_customer)' =
			-- DE's tsic_code is empty for nearly all customers, so use the TSIC merged from silver dim_tsic (2-digit division)
			VAR d = 'silver dim_customer'[division_label]
			RETURN IF ( LEN ( d ) = 0, "ไม่ระบุ", d )
		dataType: string
		lineageTag: 5096605b-238e-4024-bd3b-abbd55c162d2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

