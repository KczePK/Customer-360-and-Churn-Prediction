table _measure_segment
	lineageTag: 144d14f2-1e38-49d2-97f2-025675661aa9

	measure 'Service Customers (As-of today)' =
			
			VAR k = [As-of Month Key]
			RETURN
			    CALCULATE (
			        COUNTROWS ( 'gold fact_customer_rfm_monthly' ),
			        'gold fact_customer_rfm_monthly'[snapshot_date_key] = k
			    )
			--As-of Customer on the latest snapshot
			--this month (1 month only)
		formatString: 0
		lineageTag: ddd33454-9927-4242-a362-cee3a21ee458

	measure '% of Customers' =
			
			VAR ThisSegment =
			    CALCULATE (
			        [Service Customers (As-of today)],
			        KEEPFILTERS ( LEFT ( 'gold fact_customer_rfm_monthly'[segment], 2 ) <> "11" )
			    )
			VAR AllExclLost =
			    CALCULATE (
			        [Service Customers (As-of today)],
			        REMOVEFILTERS ( 'gold dim_segment' ),
			        REMOVEFILTERS ( 'gold fact_customer_rfm_monthly'[segment] ),
			        LEFT ( 'gold fact_customer_rfm_monthly'[segment], 2 ) <> "11"
			    )
			RETURN
			    DIVIDE ( ThisSegment, AllExclLost )
		lineageTag: 598ebf5b-1c58-45ba-bc2f-4debb50098e5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Segment (as of)' =
			
			VAR k = [As-of Month Key]
			RETURN
			    CALCULATE (
			        SELECTEDVALUE ( 'gold fact_customer_rfm_monthly'[segment] ),
			        'gold fact_customer_rfm_monthly'[snapshot_date_key] = k
			    )
		lineageTag: 418be905-9481-4b5e-ba4c-28ea55e277b8

	measure 'RFM Code' =
			
			VAR k = [As-of Month Key]
			RETURN
			    CALCULATE (
			        SELECTEDVALUE ( 'gold fact_customer_rfm_monthly'[rfm_code] ),
			        'gold fact_customer_rfm_monthly'[snapshot_date_key] = k
			    )
		lineageTag: 6af2ee0a-cf5b-46b7-a6ef-be2c8b5616ab

	measure 'R Score' =
			
			VAR k = [As-of Month Key]
			RETURN
			    IF (
			        HASONEVALUE ( 'gold fact_customer_rfm_monthly'[enterprise_id] ),
			        CALCULATE (
			            MAX ( 'gold fact_customer_rfm_monthly'[r_score] ),
			            'gold fact_customer_rfm_monthly'[snapshot_date_key] = k
			        )
			    )
		formatString: 0
		lineageTag: 1f0ad949-887a-4cd7-9595-019614fe20ce

	measure 'F Score' =
			
			VAR k = [As-of Month Key]
