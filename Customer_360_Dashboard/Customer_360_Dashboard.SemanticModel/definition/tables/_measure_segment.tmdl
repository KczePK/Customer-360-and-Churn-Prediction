	measure 'Overdue Ratio' =
			
			VAR k = [As-of Month Key]
			RETURN
			    IF (
			        HASONEVALUE ( 'gold fact_customer_rfm_monthly'[enterprise_id] ),
			        CALCULATE (
			            MAX ( 'gold fact_customer_rfm_monthly'[overdue_ratio] ),
			            'gold fact_customer_rfm_monthly'[snapshot_date_key] = k
			        )
			    )
		formatString: 0.0
		lineageTag: 518bc6d2-1616-422f-9170-a280e4acf761

	measure '% of Revenue' =
			
			-- share of 12-month revenue (as-of month) by segment; pairs with % of Customers
			VAR ThisSegment = [12m Revenue]
			VAR AllSegments =
			    CALCULATE (
			        [12m Revenue],
			        REMOVEFILTERS ( 'gold dim_segment' ),
			        REMOVEFILTERS ( 'gold fact_customer_rfm_monthly'[segment] )
			    )
			RETURN
			    DIVIDE ( ThisSegment, AllSegments )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9d679167-83f8-49a3-a61f-0dd87c123e30

	measure 'Service Revenue by Segment' =
			
			-- Service revenue (fact_revenue_line) that follows the segment selection.
			-- dim_segment only filters fact_customer_rfm_monthly, so pass the customers
			-- in the selected segment(s) at the as-of month to fact_revenue_line.
			VAR k = [As-of Month Key]
			VAR SegmentSelected =
			    ISFILTERED ( 'gold dim_segment' )
			        || ISFILTERED ( 'gold fact_customer_rfm_monthly'[segment] )
			VAR SegCustomers =
			    CALCULATETABLE (
			        VALUES ( 'gold fact_customer_rfm_monthly'[enterprise_id] ),
			        'gold fact_customer_rfm_monthly'[snapshot_date_key] = k
			    )
			RETURN
			    IF (
			        SegmentSelected,
			        CALCULATE (
			            [Service Revenue],
			            KEEPFILTERS ( TREATAS ( SegCustomers, 'gold fact_revenue_line'[enterprise_id] ) )
			        ),
			        [Service Revenue]
			    )
		formatString: #,0
		lineageTag: 6de48811-217e-4239-ae5d-3e05a2a5e515

	measure 'Research Usual Gap (months)' =
			
			-- average months between signing months (research, as-of month); blank with only one signing month
			VAR rk = [Research As-of Month Key]
			RETURN
			    IF (
			        HASONEVALUE ( 'gold fact_research_customer_monthly'[enterprise_id] ),
			        CALCULATE (
			            MAX ( 'gold fact_research_customer_monthly'[avg_gap_months] ),
			            REMOVEFILTERS ( 'gold dim_date' ),
			            'gold fact_research_customer_monthly'[snapshot_date_key] = rk
			        )
			    )
		formatString: 0.0
		lineageTag: 890b57d9-2aa3-48b6-813f-af07dc1d0a10

	measure 'Research Overdue Ratio' =
			
			-- months since last signing / usual gap (research, as-of month); above 1 = later than usual
			VAR rk = [Research As-of Month Key]
			RETURN
			    IF (
			        HASONEVALUE ( 'gold fact_research_customer_monthly'[enterprise_id] ),
			        CALCULATE (
			            MAX ( 'gold fact_research_customer_monthly'[overdue_ratio] ),
			            REMOVEFILTERS ( 'gold dim_date' ),
			            'gold fact_research_customer_monthly'[snapshot_date_key] = rk
			        )
			    )
		formatString: 0.0
		lineageTag: 8b9b6804-052b-4a70-8a78-1cefe2f5ac59

	column Column
		formatString: 0
		lineageTag: 64553047-c5c8-4f63-a542-86bab570c17f
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition _measure_segment = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 2434c53308a94189ac3447afeaab3372

	annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":""}

