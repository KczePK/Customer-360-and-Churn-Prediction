	measure 'Months Since Last Invoice' =
			
			VAR k = [As-of Month Key]
			RETURN
			    CALCULATE (
			        AVERAGE ( 'gold fact_customer_rfm_monthly'[recency_months] ),
			        'gold fact_customer_rfm_monthly'[snapshot_date_key] = k
			    )
		lineageTag: a967e71f-3ba9-4394-bc6d-8c70dbc07534

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Usual Gap (months)' =
			
			VAR k = [As-of Month Key]
			RETURN
			    IF (
			        HASONEVALUE ( 'gold fact_customer_rfm_monthly'[enterprise_id] ),
			        CALCULATE (
			            MAX ( 'gold fact_customer_rfm_monthly'[avg_gap_months] ),
			            'gold fact_customer_rfm_monthly'[snapshot_date_key] = k
			        )
			    )
		formatString: 0.0
		lineageTag: 024f51a3-231e-414b-8ed9-d752bfab63c7

	measure 'Tenure (months)' =
			
			VAR k = [As-of Month Key]
			RETURN
			    IF (
			        HASONEVALUE ( 'gold fact_customer_rfm_monthly'[enterprise_id] ),
			        CALCULATE (
